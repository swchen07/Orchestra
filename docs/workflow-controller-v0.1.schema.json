{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-webui:workflow-controller:0.1",
  "title": "Workflow Controller Action v0.1 — design draft",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "propose_plan"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "plan": {
          "$ref": "urn:open-webui:workflow-graph:0.1"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "plan"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "patch_plan"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "changes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add_node"
                  },
                  "node": {
                    "$ref": "urn:open-webui:workflow-graph:0.1#/$defs/node"
                  }
                },
                "required": [
                  "op",
                  "node"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "update_node"
                  },
                  "node": {
                    "$ref": "urn:open-webui:workflow-graph:0.1#/$defs/node"
                  }
                },
                "required": [
                  "op",
                  "node"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove_node"
                  },
                  "node_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "op",
                  "node_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_binding"
                  },
                  "binding_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "module_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "op",
                  "binding_id",
                  "module_ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add_edge"
                  },
                  "edge": {
                    "$ref": "urn:open-webui:workflow-graph:0.1#/$defs/edge"
                  }
                },
                "required": [
                  "op",
                  "edge"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove_edge"
                  },
                  "edge_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "op",
                  "edge_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_result"
                  },
                  "node_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "op",
                  "node_id"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "dispatch"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "node_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "wait"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "call_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_wait_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "call_ids",
        "max_wait_seconds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "send"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "from_node": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "to_node": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "question",
            "report",
            "notice"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "from_node",
        "to_node",
        "kind",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "request_input"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "question"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "const": "finish"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "urn:open-webui:workflow-graph:0.1#/$defs/value_ref"
          }
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "base_revision",
        "action",
        "reason",
        "outputs"
      ],
      "additionalProperties": false
    }
  ]
}

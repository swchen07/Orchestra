{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-webui:workflow-graph:1.0",
  "title": "Open WebUI workflow graph 1.0",
  "description": "Data references compile dependency edges. The executor advances ready nodes independently. Controller revisions can modify unstarted nodes. Bindings resolve only against the Project module catalog.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "op": {
            "enum": [
              "call",
              "route",
              "map",
              "join",
              "loop",
              "checkpoint",
              "finish"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "binding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "instruction": {
            "type": "string",
            "maxLength": 16000
          },
          "inputs": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "source": {
                  "enum": [
                    "input",
                    "node",
                    "report",
                    "literal"
                  ]
                },
                "pointer": {
                  "type": "string"
                },
                "node": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
                },
                "report_ref": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                },
                "value": {}
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "context_key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          },
          "output_schema": {
            "type": [
              "boolean",
              "object"
            ]
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 2,
            "maxItems": 12,
            "uniqueItems": true
          },
          "policy": {
            "enum": [
              "all_terminal",
              "all_success",
              "first_success",
              "quorum"
            ]
          },
          "quorum": {
            "type": "integer",
            "minimum": 1
          },
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "enum": [
                  "input",
                  "node",
                  "report",
                  "literal"
                ]
              },
              "pointer": {
                "type": "string"
              },
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
              },
              "report_ref": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "value": {}
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "stop_when": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string"
              },
              "equals": {}
            },
            "required": [
              "pointer",
              "equals"
            ],
            "additionalProperties": false
          },
          "question": {
            "type": "string",
            "maxLength": 8000
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "input_schema": {
            "type": [
              "boolean",
              "object"
            ]
          },
          "input_schema_inferred": {
            "type": "boolean"
          },
          "environment": {
            "type": "object",
            "properties": {
              "filesystem": {
                "enum": [
                  "inherit",
                  "none",
                  "read-only"
                ]
              },
              "tools": {
                "enum": [
                  "inherit",
                  "none"
                ]
              },
              "network": {
                "enum": [
                  "inherit",
                  "provider-only"
                ]
              },
              "isolation": {
                "enum": [
                  "logical",
                  "process",
                  "sandbox"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "op"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 320,
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          },
          "on": {
            "enum": [
              "success",
              "terminal",
              "case"
            ]
          },
          "case": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "result_node": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "input_policy": {
      "enum": [
        "shared",
        "scoped"
      ]
    },
    "controller": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "type": "string"
            },
            "initial": {
              "type": "boolean"
            },
            "on_events": {
              "type": "boolean"
            },
            "instructions": {
              "type": "string",
              "maxLength": 16000
            },
            "catalog_scope": {
              "enum": [
                "project",
                "roles"
              ]
            }
          },
          "required": [
            "binding"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "type": "string"
            },
            "instructions": {
              "type": "string",
              "maxLength": 8000
            },
            "max_repairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "binding"
          ],
          "additionalProperties": false
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_replans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "input_schema": {
      "type": [
        "boolean",
        "object"
      ]
    },
    "output_schema": {
      "type": [
        "boolean",
        "object"
      ]
    },
    "output_schema_inferred": {
      "type": "boolean"
    }
  },
  "required": [
    "nodes",
    "result_node"
  ],
  "additionalProperties": false
}
